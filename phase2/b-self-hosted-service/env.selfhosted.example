# Copy to .env.selfhosted in the repo root (chmod 600) and fill in.
# Use a separate terminal for these: Claude Code and `docker compose` read the same variables.

# Guide 21 · Step 2: point the SDK and the `ant` CLI at YOUR server.
ANTHROPIC_BASE_URL=http://127.0.0.1:8400
# The server API key (CMA_SERVER__API_KEY from the server's .env), not a Claude API key.
ANTHROPIC_API_KEY=

# Guide 21 · Step 3: use the generated resource files and the server's own environment.
CONCIERGE_MANAGED_DIR=phase2/b-self-hosted-service/managed
CONCIERGE_ENVIRONMENT_ID=env_...

# Guide 21 · Step 5: no OAuth refresh on a self-hosted server, so the Calendar takes a fixed
# token. Set the same value where `concierge serve` runs, and rotate it yourself.
CONCIERGE_CALENDAR_STATIC_TOKEN=

# The mock services, as in phase 1.
CONCIERGE_PUBLIC_BASE_URL=https://concierge.example.com
CONCIERGE_EVENTDB_TOKEN=
CONCIERGE_CLOUDCREDITS_API_KEY=
CONCIERGE_ORGANIZER_PASSWORD=

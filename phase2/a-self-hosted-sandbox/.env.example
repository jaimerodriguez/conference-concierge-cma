# Phase 2a worker settings. Copy to .env in this folder (git-ignored); `docker compose`
# reads it automatically. Exporting the same names in your shell works too.
# These are NOT read from the repo's top-level .env.

# The self-hosted environment's ID: `uv run concierge setup show`, row environments/self-hosted.yaml.
ANTHROPIC_ENVIRONMENT_ID=env_...
# Generate it in the Console on the concierge-self-hosted environment's page.
# It is not your Claude API key; never put ANTHROPIC_API_KEY on the worker host.
ANTHROPIC_ENVIRONMENT_KEY=
# Optional: send tool spans to an OTLP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Claude API -----------------------------------------------------------
# Either export ANTHROPIC_API_KEY, or run `ant auth login` and leave this unset.
# ANTHROPIC_API_KEY=

# Console links ONLY. This does not choose where anything is created: `ant apply` and the
# Python code use the workspace of your credentials (your `ant` profile, or the workspace
# that owns ANTHROPIC_API_KEY). See "Which workspace?" in docs/guides/00-setting-up.md.
# Set it to the same workspace you are signed in to, or the printed links will not open.
CONCIERGE_WORKSPACE=default

# --- Demo services (your own machine, exposed through a tunnel) -----------
# Public HTTPS address of `concierge serve`, without a trailing slash.
# Anthropic's MCP proxy and the cloud sandbox call this address.
CONCIERGE_PUBLIC_BASE_URL=https://concierge.example.com

# Pretend secrets for the mock services. Generate your own, for example with
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
CONCIERGE_ORGANIZER_PASSWORD=change-me
CONCIERGE_EVENTDB_TOKEN=change-me
CONCIERGE_CLOUDCREDITS_API_KEY=change-me

# --- Demo settings --------------------------------------------------------
CONCIERGE_TIMEZONE=America/Los_Angeles
CONCIERGE_DB_PATH=.concierge/concierge.db

# --- OpenTelemetry (Guide 05) --------------------------------------------
# Leave unset to print nothing; set to the collector from docker-compose.yml.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to "content" to record prompts and responses in spans (read Guide 05 first).
CONCIERGE_OTEL_CONTENT_MODE=metadata_only

# --- Phase 2 (see docs/guides/20-*.md and 21-*.md) -------------------------
# Which environment sessions use: "cloud" (phase 1) or "self-hosted" (phase 2a).
# CONCIERGE_ENVIRONMENT=cloud
# Phase 2b: the environment your own server created, and a fixed Calendar token.
# CONCIERGE_ENVIRONMENT_ID=env_...
# CONCIERGE_MANAGED_DIR=phase2/b-self-hosted-service/managed
# CONCIERGE_CALENDAR_STATIC_TOKEN=
